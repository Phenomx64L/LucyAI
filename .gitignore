# Dependencies
node_modules

# Build outputs
/build
/.svelte-kit
/package
src-tauri/target
# v1.8 — CUALQUIER crate, no solo src-tauri. Al añadir `lucy-core` como segundo
# crate, su `target/` no estaba cubierto por ninguna regla: un `git add
# lucy-core/` metió 1507 ficheros de artefactos en el índice y el remoto rechazó
# el push. Las reglas por ruta envejecen mal en cuanto el repo deja de tener un
# solo crate; ésta cubre los que vengan.
**/target/
# Repo-root target/ — PGO profile data + logs written by scripts/build-pgo.ps1
# (its default -ProfilesDir is .\target\pgo-profiles). Build artifacts only.
/target

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE
.idea
*.swp
*.swo
.claude

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs & debug
*.log
svelte_errors.txt

# Archives / local bundles
*.rar
*.7z
*.zip

# Local one-off patch / apply scripts (kept out of the tree)
patch_*.cjs
patch_*.mjs
apply*.mjs
apply_orchestrator*.js
sync_lucy.cjs

# Local test artifacts (system health HTML reports)
src-tauri/Reporte_Sistema.html
src-tauri/Reporte_Sistema_*.html
