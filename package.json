{
  "name": "lucy-svelte",
  "version": "1.4.29",
  "description": "Lucy — Autonomous SysAdmin AI Assistant (Tauri + Svelte + Rust)",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contract": "cd src-tauri && cargo test --lib",
    "test:full": "npm run check && npm run test && cd src-tauri && cargo test --lib -- --test-threads=1",
    "benchmark": "node scripts/benchmark.mjs",
    "hooks:install": "node scripts/install-hooks.cjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@formkit/auto-animate": "^0.9.0",
    "@tabler/icons-svelte": "^3.41.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-sql": "^2.3.2",
    "bits-ui": "^2.18.1",
    "dompurify": "^3.3.3",
    "highlight.js": "^11.11.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "marked": "^17.0.4",
    "shiki": "^4.1.0",
    "svelte-sonner": "^1.1.1",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^25.9.1",
    "brotli": "^1.3.3",
    "jsdom": "^29.1.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
