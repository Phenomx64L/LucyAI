[
    {"id":"W1.1","title":"Ensure password history is 24 or more","category":"Accounts","severity":"high","command":"net accounts | Select-String 'Length of password history' | ForEach-Object { if(($_ -replace '\\D','') -ge 24){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"net accounts /uniquepw:24"},
    {"id":"W1.2","title":"Ensure minimum password length >= 8","category":"Accounts","severity":"high","command":"net accounts | Select-String 'Minimum password length' | ForEach-Object { if(($_ -replace '\\D','') -ge 8){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"net accounts /minpwlen:8"},
    {"id":"W1.3","title":"Ensure lockout threshold is 5 or less","category":"Accounts","severity":"high","command":"net accounts | Select-String 'Lockout threshold' | ForEach-Object { $v=($_ -replace '\\D',''); if($v -gt 0 -and $v -le 5){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"net accounts /lockoutthreshold:5"},
    {"id":"W2.1","title":"Ensure Windows Firewall is enabled (Domain)","category":"Firewall","severity":"critical","command":"(Get-NetFirewallProfile -Name Domain).Enabled | ForEach-Object { if($_){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Set-NetFirewallProfile -Profile Domain -Enabled True"},
    {"id":"W2.2","title":"Ensure Windows Firewall is enabled (Private)","category":"Firewall","severity":"critical","command":"(Get-NetFirewallProfile -Name Private).Enabled | ForEach-Object { if($_){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Set-NetFirewallProfile -Profile Private -Enabled True"},
    {"id":"W2.3","title":"Ensure Windows Firewall is enabled (Public)","category":"Firewall","severity":"critical","command":"(Get-NetFirewallProfile -Name Public).Enabled | ForEach-Object { if($_){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Set-NetFirewallProfile -Profile Public -Enabled True"},
    {"id":"W3.1","title":"Ensure Windows Defender is enabled","category":"Antivirus","severity":"critical","command":"(Get-MpComputerStatus -ErrorAction SilentlyContinue).AntivirusEnabled | ForEach-Object { if($_){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Set-MpPreference -DisableRealtimeMonitoring $false"},
    {"id":"W3.2","title":"Ensure Windows Defender signatures are up to date","category":"Antivirus","severity":"high","command":"$d=(Get-MpComputerStatus -ErrorAction SilentlyContinue).AntivirusSignatureLastUpdated; if($d -gt (Get-Date).AddDays(-3)){'PASS'}else{'FAIL'}","expect":{"stdout_contains":"PASS"},"remediation":"Update-MpSignature"},
    {"id":"W4.1","title":"Ensure Remote Desktop is NLA-only","category":"Remote Access","severity":"high","command":"(Get-ItemProperty 'HKLM:\\SYSTEM\\CurrentControlSet\\Control\\Terminal Server\\WinStations\\RDP-Tcp' -Name UserAuthentication -ErrorAction SilentlyContinue).UserAuthentication | ForEach-Object { if($_ -eq 1){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Enable Network Level Authentication for RDP"},
    {"id":"W4.2","title":"Ensure guest account is disabled","category":"Accounts","severity":"critical","command":"(Get-LocalUser Guest -ErrorAction SilentlyContinue).Enabled | ForEach-Object { if(-not $_){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Disable-LocalUser -Name Guest"},
    {"id":"W5.1","title":"Ensure audit policy for logon events","category":"Logging","severity":"high","command":"auditpol /get /subcategory:'Logon' 2>$null | Select-String 'Success and Failure' | ForEach-Object {'PASS'}; if(-not $_){'CHECK'}","expect":{"stdout_contains":"PASS"},"remediation":"auditpol /set /subcategory:'Logon' /success:enable /failure:enable"},
    {"id":"W5.2","title":"Ensure Windows Event Log service is running","category":"Logging","severity":"high","command":"(Get-Service EventLog).Status | ForEach-Object { if($_ -eq 'Running'){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Start-Service EventLog"},
    {"id":"W6.1","title":"Ensure SMBv1 is disabled","category":"Network","severity":"critical","command":"(Get-WindowsOptionalFeature -Online -FeatureName SMB1Protocol -ErrorAction SilentlyContinue).State | ForEach-Object { if($_ -eq 'Disabled' -or $_ -eq $null){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Disable-WindowsOptionalFeature -Online -FeatureName SMB1Protocol"},
    {"id":"W6.2","title":"Ensure PowerShell script execution policy","category":"System","severity":"medium","command":"Get-ExecutionPolicy | ForEach-Object { if($_ -ne 'Unrestricted'){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Set-ExecutionPolicy RemoteSigned"},
    {"id":"W7.1","title":"Ensure Windows Update service is running","category":"Updates","severity":"high","command":"(Get-Service wuauserv).Status | ForEach-Object { if($_ -eq 'Running'){'PASS'}else{'CHECK'} }","expect":{"stdout_contains":"PASS"},"remediation":"Start-Service wuauserv"},
    {"id":"W7.2","title":"Check pending updates count","category":"Updates","severity":"medium","command":"try { $s=New-Object -ComObject Microsoft.Update.Session; $u=$s.CreateUpdateSearcher().Search('IsInstalled=0').Updates.Count; Write-Output \"$u pending\" } catch { 'CHECK' }","expect":{"exit_code":0},"remediation":"Install pending Windows Updates"},
    {"id":"W8.1","title":"Ensure NTP time synchronization","category":"System","severity":"medium","command":"w32tm /query /status 2>$null | Select-String 'Leap Indicator' | ForEach-Object {'PASS'}; if(-not $_){ if((Get-Service W32Time).Status -eq 'Running'){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Start-Service W32Time; w32tm /resync"},
    {"id":"W8.2","title":"Ensure UAC is enabled","category":"System","severity":"high","command":"(Get-ItemProperty HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System -Name EnableLUA).EnableLUA | ForEach-Object { if($_ -eq 1){'PASS'}else{'FAIL'} }","expect":{"stdout_contains":"PASS"},"remediation":"Set EnableLUA to 1 in registry and restart"},
    {"id":"W8.3","title":"Ensure BitLocker is enabled on OS drive","category":"Encryption","severity":"high","command":"(Get-BitLockerVolume -MountPoint C: -ErrorAction SilentlyContinue).ProtectionStatus | ForEach-Object { if($_ -eq 'On'){'PASS'}else{'CHECK'} }","expect":{"stdout_contains":"PASS"},"remediation":"Enable-BitLocker -MountPoint C: -EncryptionMethod Aes256"},
    {"id":"W8.4","title":"Ensure Secure Boot is enabled","category":"System","severity":"medium","command":"try { if(Confirm-SecureBootUEFI){'PASS'}else{'FAIL'} } catch {'N/A'}","expect":{"stdout_contains":"PASS"},"remediation":"Enable Secure Boot in BIOS/UEFI settings"}
]
