{
  "$schema": "https://schema.tauri.app/2.0.0/schema.json",
  "productName": "Lucy Assistant",
  "version": "1.4.0",
  "identifier": "com.lucy.dev",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lucy Assistant",
        "width": 1200,
        "height": 850,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#060a0f"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:*; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: tauri: asset: https://asset.localhost; media-src 'self' mediastream: blob:; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; worker-src 'self' blob:; manifest-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "Iván Eduardo Luna (@Phenomx64L)",
    "copyright": "Copyright © 2026 Iván Eduardo Luna. Licensed under GPLv3.",
    "category": "DeveloperTool",
    "shortDescription": "Autonomous SysAdmin AI Assistant",
    "longDescription": "Lucy is an autonomous AI assistant for Windows system administration: agentic loops, multi-host management (WinRM/SSH), compliance scans, runbooks, and tiered persistent memory. Built on Tauri + SvelteKit + Rust.",
    "homepage": "https://github.com/Phenomx64L/LucyAI",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null,
      "timestampUrl": "",
      "// Bundle the WebView2 runtime offline-installer so first-launch": "",
      "// works even on machines without internet. Adds ~120 MB to the": "",
      "// installer; acceptable per user request (May 2026) — Lucy is a": "",
      "// SysAdmin tool that frequently runs on locked-down corp boxes": "",
      "// where the WebView2 bootstrapper download path is blocked.": "",
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "wix": {
        "language": [
          "en-US",
          "es-MX"
        ]
      },
      "nsis": {
        "// Per-user OR per-machine — user picks at install time.": "",
        "// 'currentUser' avoids UAC entirely; 'perMachine' needs admin": "",
        "// but lets all Windows users share the same install.": "",
        "installMode": "both",
        "languages": [
          "English",
          "Spanish",
          "SpanishInternational"
        ],
        "displayLanguageSelector": true,
        "// Tauri NSIS automatically creates Start Menu shortcut AND a": "",
        "// proper Uninstall entry in Programs & Features. The .nsi": "",
        "// template also offers a 'Desktop shortcut' checkbox to the": "",
        "// user during install — no extra config needed.": "",
        "installerIcon": "icons/icon.ico",
        "// installerSidebar / installerHeaderImage — leave to defaults": "",
        "// for now; can add a branded 164x314 BMP later for the": "",
        "// 'Welcome' page sidebar.": "",
        "compression": "lzma"
      }
    }
  }
}